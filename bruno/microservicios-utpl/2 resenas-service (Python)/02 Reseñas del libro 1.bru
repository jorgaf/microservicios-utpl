meta {
  name: Reseñas del libro 1
  type: http
  seq: 2
}

get {
  url: {{resenasUrl}}/resenas?libroId=1
  body: none
  auth: none
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("todas son del libro 1", function() {
    res.getBody().forEach(r => expect(r.libroId).to.equal(1));
  });
}
