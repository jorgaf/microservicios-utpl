meta {
  name: Libros vía gateway
  type: http
  seq: 2
}

get {
  url: {{gatewayUrl}}/api/libros
  body: none
  auth: none
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("el gateway enrutó a libros-service", function() {
    expect(res.getHeader("x-upstream")).to.equal("libros-service");
  });
}
