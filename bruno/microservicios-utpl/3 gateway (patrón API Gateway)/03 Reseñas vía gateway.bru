meta {
  name: Reseñas vía gateway
  type: http
  seq: 3
}

get {
  url: {{gatewayUrl}}/api/resenas?libroId=2
  body: none
  auth: none
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("el gateway enrutó a resenas-service", function() {
    expect(res.getHeader("x-upstream")).to.equal("resenas-service");
  });
}
