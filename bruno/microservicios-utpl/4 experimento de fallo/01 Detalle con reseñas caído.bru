meta {
  name: Detalle con reseñas caído
  type: http
  seq: 1
}

get {
  url: {{gatewayUrl}}/api/libros/1/detalle
  body: none
  auth: none
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("el libro sigue llegando", function() {
    expect(res.getBody().libro.titulo).to.equal("Huasipungo");
  });
  test("la respuesta viene marcada como degradada", function() {
    expect(res.getBody().degradado).to.equal(true);
  });
}

docs {
  Un servicio caído NO tumba todo el sistema: el gateway entrega lo que puede.
}
