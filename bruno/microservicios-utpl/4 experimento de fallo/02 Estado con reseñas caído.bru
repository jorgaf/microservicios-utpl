meta {
  name: Estado con reseñas caído
  type: http
  seq: 2
}

get {
  url: {{gatewayUrl}}/api/estado
  body: none
  auth: none
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("resenas-service aparece DOWN", function() {
    expect(res.getBody().servicios["resenas-service"].status).to.equal("DOWN");
  });
  test("libros-service sigue UP", function() {
    expect(res.getBody().servicios["libros-service"].status).to.equal("UP");
  });
}
